# =============================================================================
# Apex Vision - Unified Environment Configuration (Template)
# =============================================================================

# 🟦 PostgreSQL
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=jupiter
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/jupiter

# 🟦 JWT & Security
JWT_SECRET=change_me_in_production
JWT_EXPIRY_MINUTES=15
JWT_REFRESH_EXPIRY_HOURS=168

# 🟦 RabbitMQ
RABBITMQ_HOST=localhost
RABBITMQ_PORT=5672
RABBITMQ_USER=guest
RABBITMQ_PASS=guest
RABBITMQ_VHOST=/
RABBITMQ_URL=amqp://guest:guest@localhost:5672/

# Colas (Workers)
PROSODY_QUEUE=prosody.jobs
SCORING_QUEUE=scoring.jobs

# 🟦 Object Storage (MinIO / S3)
MINIO_ENDPOINT=localhost:9000
MINIO_PUBLIC_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=jupiter-videos
MINIO_USE_SSL=false
MINIO_PUBLIC_USE_SSL=false
MINIO_PORT=9000

# Endpoint de compatibilidad S3 (para los workers)
S3_ENDPOINT_URL=http://localhost:9000
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET=jupiter-videos
S3_REGION=us-east-1

# 🟦 API Gateway
GATEWAY_PORT=8080
PORT=8080
CORS_ALLOW_ORIGIN=http://localhost:5173

# 🟦 Frontend (Vite)
FRONTEND_PORT=5173
VITE_API_URL=http://localhost:8080

# 🟦 LLM Providers
# Groq (Requerido por Whisper y Scoring Workers)
GROQ_API_KEY=

# OpenAI
OPENAI_API_KEY=

# Voice Coach (DeepSeek + ElevenLabs)
DEEPSEEK_API_KEY=
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=EXAVITQu4vr4xnSDxMaL
ELEVENLABS_MODEL_ID=eleven_multilingual_v2

# 🟦 Seeds / Demo Data
SEED_DEMO_SELLER_EMAIL=seller.demo@jupiter.local
SEED_DEMO_SELLER_PASSWORD=Demo1234!
SEED_DEMO_ADMIN_EMAIL=admin.demo@jupiter.local
SEED_DEMO_ADMIN_PASSWORD=Demo1234!
SEED_DEMO_AT_CREDITS=200

# 🟦 Stripe Billing
STRIPE_SECRET_KEY=sk_test_replace_me
STRIPE_PUBLISHABLE_KEY=pk_test_replace_me
