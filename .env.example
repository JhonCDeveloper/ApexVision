# =============================================================================
# Jupiter — Environment Variables
# Copy this file to .env and fill in your values
# =============================================================================

# ── PostgreSQL ────────────────────────────────────────────────────────────────
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=<TU_CONTRASEÑA_SEGURA>
DB_NAME=jupiter

# ── JWT ───────────────────────────────────────────────────────────────────────
JWT_SECRET=<SECRETO_JWT_ALEATORIO>
JWT_EXPIRY_MINUTES=15
JWT_REFRESH_EXPIRY_HOURS=168

# ── RabbitMQ ──────────────────────────────────────────────────────────────────
RABBITMQ_URL=amqp://guest:guest@localhost:5672/
RABBITMQ_USER=guest
RABBITMQ_PASS=<TU_CLAVE_RABBIT>
RABBITMQ_PORT=5672

# ── MinIO ─────────────────────────────────────────────────────────────────────
MINIO_ENDPOINT=localhost:9000
MINIO_PUBLIC_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=<TU_CLAVE_MINIO>
MINIO_BUCKET=jupiter-videos
MINIO_USE_SSL=false
MINIO_PUBLIC_USE_SSL=false
MINIO_PORT=9000

# ── API Gateway ───────────────────────────────────────────────────────────────
GATEWAY_PORT=8080
CORS_ALLOW_ORIGIN=http://localhost:5173

# ── Groq ────────────────────────────────────────────────────────────────────
GROQ_API_KEY=               # console.groq.com/keys — necesario para Whisper y Scoring

# ── Voice Coach (DeepSeek + ElevenLabs) ──────────────────────────────────────
DEEPSEEK_API_KEY=
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=EXAVITQu4vr4xnSDxMaL
ELEVENLABS_MODEL_ID=eleven_multilingual_v2

# ── Frontend ──────────────────────────────────────────────────────────────────
FRONTEND_PORT=5173
VITE_API_URL=http://localhost:8080

# ── Migrations ────────────────────────────────────────────────────────────────
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/jupiter

# ── Seed ──────────────────────────────────────────────────────────────────────
# Optional: set to a specific tenant UUID to seed into that tenant
# If not set, seed uses the first existing tenant or creates a Demo Company
# SEED_TENANT_ID=
SEED_DEMO_SELLER_EMAIL=seller.demo@jupiter.local
SEED_DEMO_SELLER_PASSWORD=<CONTRASEÑA_DEMO>
SEED_DEMO_ADMIN_EMAIL=admin.demo@jupiter.local
SEED_DEMO_ADMIN_PASSWORD=<CONTRASEÑA_DEMO>
SEED_DEMO_AT_CREDITS=200

# ── Stripe Billing ────────────────────────────────────────────────────────────
STRIPE_SECRET_KEY=sk_test_replace_me
STRIPE_PUBLISHABLE_KEY=pk_test_replace_me
STRIPE_WEBHOOK_SECRET=whsec_replace_me
STRIPE_PRICE_STARTER=price_replace_me
STRIPE_PRICE_GROWTH=price_replace_me
STRIPE_PRICE_PRO=price_replace_me
STRIPE_PRICE_SCALE=price_replace_me
STRIPE_PRICE_TOPUP_S=price_replace_me
STRIPE_PRICE_TOPUP_M=price_replace_me
STRIPE_PRICE_TOPUP_L=price_replace_me
BILLING_SUCCESS_URL=http://localhost:5173/billing-success.html
BILLING_CANCEL_URL=http://localhost:5173/billing-cancel.html
